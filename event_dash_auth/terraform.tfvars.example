ecs_cluster_arn   = "arn:aws:ecs:REGION:ACCOUNT:cluster/YOUR_CLUSTER"
vpc_id            = "vpc-xxxxx"
private_subnet_ids = ["subnet-xxx", "subnet-yyy", "subnet-zzz"]
public_subnet_ids  = ["subnet-aaa", "subnet-bbb"]
environment       = "dev"
desired_count     = 1

# Required for Cognito (HTTPS)
certificate_arn = "arn:aws:acm:REGION:ACCOUNT:certificate/CERT_ID"
# Optional: Cognito domain prefix (default: environment-app-name-account-id)
# cognito_domain_prefix = "my-event-dash-auth"

# Web app image (default: published image from platformfuzz/event-response-image)
# web_image       = "ghcr.io/platformfuzz/event-response-image:latest"
web_port          = 8080

# Optional: FastSchema secrets (same as fastschema stack)
# fastschema_app_key        = "..."
# fastschema_admin_username = "admin"
# fastschema_admin_password = "..."

# Optional: event schema (default = base64-encoded event schema so the app works without creating it in the FastSchema dashboard)
# fastschema_event_schema_b64 = "..."  # set to "" to create the schema manually in the dashboard
